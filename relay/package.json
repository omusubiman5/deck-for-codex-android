{
  "name": "codex-micro-relay",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "description": "Headless Windows/macOS Nearby relay for Codex Micro Mobile",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "node launcher/live-smoke.mjs",
    "self-test": "node dist/src/relay-runtime.js self-test",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:macos": "bash scripts/package-macos.sh"
  },
  "dependencies": {
    "bonjour-service": "1.4.3",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
